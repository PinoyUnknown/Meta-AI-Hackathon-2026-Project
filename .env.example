# Meta Global AI Developer Hackathon - Environment Configuration
# Copy this file to .env and insert your claimed API keys.
# NEVER commit the populated .env file to GitHub.

# Meta Model API (Cerebral Valley Hackathon Credits $150)
# Base URL defaults to: https://api.meta.ai/v1
MODEL_API_KEY=your_meta_model_api_key_here
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1

# Optional Inference Partners ($100 credits from Baseten / Fireworks / Modal)
FIREWORKS_API_KEY=your_fireworks_api_key_here
BASETEN_API_KEY=your_baseten_api_key_here
MODAL_TOKEN=your_modal_token_here

# Meta Safety & Guardrails
ENFORCE_LLAMA_GUARD=1
ENFORCE_PROMPT_GUARD=1
ENFORCE_CYBERSEC_EVAL=1

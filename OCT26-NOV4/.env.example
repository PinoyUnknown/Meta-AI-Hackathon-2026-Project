# ==============================================================================
# MetaFrontier NeuroTwin - Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# Copy this file to .env and insert your real credentials locally.
# ==============================================================================

# Meta Model API Credentials (Leave empty to use built-in Neural Simulation mode)
META_MODEL_API_KEY=your_meta_model_api_key_here
META_ENDPOINT_URL=http://localhost:8000

# Backend FastAPI Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Internal Security & Session Salt (Random 32+ character hex string)
SECURITY_SALT=replace_with_secure_random_hex_string_32_chars

# Safety & Invariant Thresholds
SAFETY_DERATING_FACTOR=0.12
MAX_ALLOWABLE_TORQUE_NM=120.0
MAX_THERMAL_LIMIT_CELSIUS=85.0
